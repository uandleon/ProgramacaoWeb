generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Continente {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String

  paises    Pais[]
}

model Pais {
  id             Int        @id @default(autoincrement())
  nome           String
  populacao      Int
  idioma_oficial String
  moeda          String
  id_continente  Int

  continente     Continente @relation(fields: [id_continente], references: [id])
  
  
  cidades        Cidade[]
}

model Cidade {
  id        Int    @id @default(autoincrement())
  nome      String
  populacao Int
  latitude  Float
  longitude Float
  id_pais   Int

  pais      Pais   @relation(fields: [id_pais], references: [id])
}